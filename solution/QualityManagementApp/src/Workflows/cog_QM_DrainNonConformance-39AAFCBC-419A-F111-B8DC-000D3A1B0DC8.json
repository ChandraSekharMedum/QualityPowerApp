{
  "properties": {
    "connectionReferences": {
      "cog_QMConnRef_Dataverse": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "cog_QMConnRef_Dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_an_outbox_row_is_created": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "cog_QMConnRef_Dataverse",
              "connectionReferenceName": "cog_QMConnRef_Dataverse",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 1,
              "subscriptionRequest/entityname": "cog_outbox",
              "subscriptionRequest/scope": 4
            }
          }
        }
      },
      "actions": {
        "Exit_unless_a_queued_NC": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "or": [
              {
                "not": {
                  "equals": [
                    "@triggerOutputs()?['body/cog_outboxstatus']",
                    2
                  ]
                }
              },
              {
                "not": {
                  "equals": [
                    "@triggerOutputs()?['body/cog_operationtype']",
                    2
                  ]
                }
              }
            ]
          },
          "actions": {
            "Stop": {
              "runAfter": {},
              "type": "Terminate",
              "inputs": {
                "runStatus": "Succeeded"
              }
            }
          }
        },
        "Claim_the_outbox_row": {
          "runAfter": {
            "Exit_unless_a_queued_NC": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "cog_QMConnRef_Dataverse",
              "connectionReferenceName": "cog_QMConnRef_Dataverse",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "UpdateRecord"
            },
            "parameters": {
              "entityName": "cog_outboxes",
              "recordId": "@triggerOutputs()?['body/cog_outboxid']",
              "item/cog_outboxstatus": 3,
              "item/cog_attempts": "@add(coalesce(triggerOutputs()?['body/cog_attempts'], 0), 1)"
            }
          }
        },
        "Check_for_an_already_confirmed_twin": {
          "runAfter": {
            "Claim_the_outbox_row": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "cog_QMConnRef_Dataverse",
              "connectionReferenceName": "cog_QMConnRef_Dataverse",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "ListRecords"
            },
            "parameters": {
              "entityName": "cog_outboxes",
              "$select": "cog_outboxid,cog_processedon",
              "$filter": "@concat('cog_correlationid eq ''', triggerOutputs()?['body/cog_correlationid'], ''' and cog_outboxstatus eq 4 and cog_outboxid ne ', triggerOutputs()?['body/cog_outboxid'])",
              "$top": 1
            }
          }
        },
        "Route_duplicate_or_process": {
          "runAfter": {
            "Check_for_an_already_confirmed_twin": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "greater": [
              "@length(outputs('Check_for_an_already_confirmed_twin')?['body/value'])",
              0
            ]
          },
          "actions": {
            "Mark_as_duplicate": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "cog_QMConnRef_Dataverse",
                  "connectionReferenceName": "cog_QMConnRef_Dataverse",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "cog_outboxes",
                  "recordId": "@triggerOutputs()?['body/cog_outboxid']",
                  "item/cog_outboxstatus": 6,
                  "item/cog_processedon": "@utcNow()",
                  "item/cog_lasterror": "@concat('Skipped: correlation ', triggerOutputs()?['body/cog_correlationid'], ' was already confirmed')"
                }
              }
            }
          },
          "else": {
            "actions": {
              "Process_the_submission": {
                "runAfter": {},
                "type": "Scope",
                "actions": {
                  "Parse_payload": {
                    "runAfter": {},
                    "type": "ParseJson",
                    "inputs": {
                      "content": "@triggerOutputs()?['body/cog_payload']",
                      "schema": {
                        "type": "object",
                        "properties": {
                          "Operation": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "CorrelationId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "Company": {
                            "type": "string"
                          },
                          "NonConformanceId": {
                            "type": "string"
                          },
                          "Type": {
                            "type": [
                              "integer",
                              "string"
                            ]
                          },
                          "ProblemTypeId": {
                            "type": "string"
                          },
                          "ItemId": {
                            "type": "string"
                          },
                          "NcDate": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "DefectQty": {
                            "type": [
                              "number",
                              "string",
                              "null"
                            ]
                          },
                          "Rush": {
                            "type": [
                              "integer",
                              "string",
                              "null"
                            ]
                          },
                          "VendAccount": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "CustAccount": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "RefId": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    }
                  },
                  "Create_the_non_conformance": {
                    "runAfter": {
                      "Parse_payload": [
                        "Succeeded"
                      ]
                    },
                    "type": "OpenApiConnection",
                    "inputs": {
                      "host": {
                        "connectionName": "cog_QMConnRef_Dataverse",
                        "connectionReferenceName": "cog_QMConnRef_Dataverse",
                        "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                        "operationId": "CreateRecord"
                      },
                      "parameters": {
                        "entityName": "mserp_inventnonconformancetableentities",
                        "item/mserp_inventnonconformanceid": "@body('Parse_payload')?['NonConformanceId']",
                        "item/mserp_inventnonconformancetype": "@int(body('Parse_payload')?['Type'])",
                        "item/mserp_inventtestproblemtypeid": "@body('Parse_payload')?['ProblemTypeId']",
                        "item/mserp_itemid": "@body('Parse_payload')?['ItemId']",
                        "item/mserp_nonconformancedate": "@body('Parse_payload')?['NcDate']",
                        "item/mserp_testdefectqty": "@float(coalesce(body('Parse_payload')?['DefectQty'], 0))",
                        "item/mserp_rush": "@int(coalesce(body('Parse_payload')?['Rush'], 200000000))",
                        "item/mserp_vendaccount": "@coalesce(body('Parse_payload')?['VendAccount'], '')",
                        "item/mserp_custaccount": "@coalesce(body('Parse_payload')?['CustAccount'], '')",
                        "item/mserp_inventrefid": "@coalesce(body('Parse_payload')?['RefId'], '')",
                        "item/mserp_dataareaid": "@body('Parse_payload')?['Company']"
                      }
                    }
                  }
                }
              },
              "Confirm_the_outbox_row": {
                "runAfter": {
                  "Process_the_submission": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "cog_QMConnRef_Dataverse",
                    "connectionReferenceName": "cog_QMConnRef_Dataverse",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "UpdateRecord"
                  },
                  "parameters": {
                    "entityName": "cog_outboxes",
                    "recordId": "@triggerOutputs()?['body/cog_outboxid']",
                    "item/cog_outboxstatus": 4,
                    "item/cog_processedon": "@utcNow()",
                    "item/cog_lasterror": ""
                  }
                }
              },
              "Flag_needs_attention": {
                "runAfter": {
                  "Process_the_submission": [
                    "Failed",
                    "TimedOut",
                    "Skipped"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "cog_QMConnRef_Dataverse",
                    "connectionReferenceName": "cog_QMConnRef_Dataverse",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "UpdateRecord"
                  },
                  "parameters": {
                    "entityName": "cog_outboxes",
                    "recordId": "@triggerOutputs()?['body/cog_outboxid']",
                    "item/cog_outboxstatus": 5,
                    "item/cog_processedon": "@utcNow()",
                    "item/cog_lasterror": "@substring(string(result('Process_the_submission')), 0, min(3900, length(string(result('Process_the_submission')))))"
                  }
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}